<%- include('./partials/header') %>

    <% if(success.length>0){ %>
        <div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-blue-500">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= success %>
            </span>
        </div>
        <% } %>

            <div class="min-h-screen flex flex-col">
                <div class="container px-10 py-20 flex flex-grow">
                    <div class="w-[25%] flex h-screen flex-col items-start">
                        <div class="flex flex-col">
                            <a class="block w-fit mb-2" href="/owners/myaccount">All Products</a>
                            <a class="block w-fit mb-2" href="/owners/admin">Create new product</a>
                        </div>
                    </div>
                    <main class="w-3/4 bg-white p-8 shadow ml-4 overflow-y-auto">
                        <h2 class="text-2xl font-bold mb-6 text-gray-800">Create New Product</h2>
                        <form autocomplete="off" action="/products/create" method="post" enctype="multipart/form-data">
                            <!-- Product Details -->
                            <div class="mb-8">
                                <h3 class="text-lg font-semibold mb-4 text-gray-700 border-b pb-2">Product Information</h3>
                                <div class="mb-4">
                                    <label class="block mb-2 font-medium text-gray-700">Product Image *</label>
                                    <input name="image" type="file" required class="py-2 px-4 border rounded-lg w-full focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div class="grid grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <label class="block mb-2 font-medium text-gray-700">Product Name *</label>
                                        <input name="name" type="text" placeholder="e.g., Wireless Headphones" required
                                            class="border p-3 rounded-lg w-full focus:ring-2 focus:ring-blue-500">
                                    </div>
                                    <div>
                                        <label class="block mb-2 font-medium text-gray-700">Price (₹) *</label>
                                        <input name="price" type="number" placeholder="e.g., 1999" required min="0" step="0.01"
                                            class="border p-3 rounded-lg w-full focus:ring-2 focus:ring-blue-500">
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label class="block mb-2 font-medium text-gray-700">Description</label>
                                    <textarea name="description" rows="3" placeholder="Describe your product..."
                                        class="border p-3 rounded-lg w-full focus:ring-2 focus:ring-blue-500"></textarea>
                                </div>
                                <div class="grid grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <label class="block mb-2 font-medium text-gray-700">Category</label>
                                        <select name="category" class="border p-3 rounded-lg w-full focus:ring-2 focus:ring-blue-500">
                                            <option value="general">General</option>
                                            <option value="electronics">Electronics</option>
                                            <option value="clothing">Clothing</option>
                                            <option value="home">Home & Living</option>
                                            <option value="books">Books</option>
                                            <option value="sports">Sports</option>
                                            <option value="toys">Toys</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block mb-2 font-medium text-gray-700">Discount (%)</label>
                                        <input name="discount" type="number" placeholder="e.g., 10" min="0" max="100"
                                            class="border p-3 rounded-lg w-full focus:ring-2 focus:ring-blue-500">
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <label class="block mb-2 font-medium text-gray-700">Stock Quantity</label>
                                        <input name="stock" type="number" placeholder="e.g., 50" min="0"
                                            class="border p-3 rounded-lg w-full focus:ring-2 focus:ring-blue-500">
                                    </div>
                                    <div>
                                        <label class="block mb-2 font-medium text-gray-700">Rating (0-5)</label>
                                        <input name="rating" type="number" placeholder="e.g., 4.5" min="0" max="5" step="0.1"
                                            class="border p-3 rounded-lg w-full focus:ring-2 focus:ring-blue-500">
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label class="block mb-2 font-medium text-gray-700">Tags (comma-separated)</label>
                                    <input name="tags" type="text" placeholder="e.g., wireless, bluetooth, audio"
                                        class="border p-3 rounded-lg w-full focus:ring-2 focus:ring-blue-500">
                                    <p class="text-sm text-gray-500 mt-1">Separate tags with commas</p>
                                </div>
                                <div class="mb-4">
                                    <label class="flex items-center">
                                        <input name="featured" type="checkbox" class="mr-2 w-5 h-5 text-blue-600 rounded focus:ring-2 focus:ring-blue-500">
                                        <span class="font-medium text-gray-700">Mark as Featured Product</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Panel Styling -->
                            <div class="mb-8">
                                <h3 class="text-lg font-semibold mb-4 text-gray-700 border-b pb-2">Display Styling (Optional)</h3>
                                <div class="grid grid-cols-3 gap-4">
                                    <div>
                                        <label class="block mb-2 font-medium text-gray-700">Background Color</label>
                                        <input name="bgcolor" type="color" value="#ffffff"
                                            class="border p-2 rounded-lg w-full h-12">
                                    </div>
                                    <div>
                                        <label class="block mb-2 font-medium text-gray-700">Panel Color</label>
                                        <input name="panelcolor" type="color" value="#f8fafc"
                                            class="border p-2 rounded-lg w-full h-12">
                                    </div>
                                    <div>
                                        <label class="block mb-2 font-medium text-gray-700">Text Color</label>
                                        <input name="textcolor" type="color" value="#1e293b"
                                            class="border p-2 rounded-lg w-full h-12">
                                    </div>
                                </div>
                            </div>

                            <div class="flex gap-4">
                                <button type="submit" class="px-6 py-3 rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700 transition shadow-md">
                                    Create Product
                                </button>
                                <a href="/owners/myaccount" class="px-6 py-3 rounded-lg bg-gray-200 text-gray-700 font-medium hover:bg-gray-300 transition">
                                    Cancel
                                </a>
                            </div>
                        </form>
                    </main>
                </div>
            </div>
            <%- include('./partials/footer') %>