<%- include('./partials/header') %>

<% if(success.length>0){ %>
  <div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-blue-500 z-50">
      <span class="inline-block mt-1 mb-1 text-white">
          <%= success %>
      </span>
  </div>
<% } %>

<div class="w-full min-h-screen px-20 py-20">
  <% 
    // Calculate totals for the entire page
    let cartTotal = 0;
    let totalDiscount = 0;
    let subtotal = 0;
    let totalItems = 0;
    
    if (user.cart && user.cart.length > 0) {
      user.cart.forEach(function(cartItem) { 
        // Handle both old and new cart structure
        const product = cartItem.product || cartItem;
        const quantity = cartItem.quantity || 1;
        
        if (product && product.price) {
          // Calculate item subtotal (price * quantity)
          const itemSubtotal = product.price * quantity;
          // Calculate item discount (discount * quantity)
          const itemDiscount = (product.discount || 0) * quantity;
          // Calculate item total (subtotal - discount)
          const itemTotal = itemSubtotal - itemDiscount;
          
          // Update running totals
          subtotal += itemSubtotal;
          totalDiscount += itemDiscount;
          cartTotal += itemTotal;
          totalItems += quantity;
        }
      });
    }
    
    // Platform fee
    const platformFee = 20;
    // Final total including platform fee
    const finalTotal = Math.max(0, cartTotal + platformFee);
  %>

  <% 
    // Calculate the actual number of items in cart, handling both old and new structures
    let itemCount = 0;
    if (user.cart && user.cart.length > 0) {
      user.cart.forEach(function(cartItem) {
        // For new structure, each cartItem is an object with product and quantity
        // For old structure, each cartItem is just a product ID
        itemCount += (cartItem.quantity || 1);
      });
    }
  %>

  <!-- Cart Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold">Shopping Cart</h1>
  </div>

  <% if(!user.cart || user.cart.length === 0 || itemCount === 0) { %>
    <!-- Empty Cart -->
    <div class="text-center py-20">
      <div class="text-6xl mb-4">🛒</div>
      <h2 class="text-2xl font-semibold mb-2">Your cart is empty</h2>
      <p class="text-gray-600 mb-6">Add some products to get started!</p>
      <a href="/shop" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700">
        Continue Shopping
      </a>
    </div>
  <% } else { %>

  <!-- Cart Items -->
  <div class="flex gap-8">
    <!-- Items List -->
    <div class="w-[65%] space-y-6">
      <% user.cart.forEach(function(cartItem){ 
        // Handle both old and new cart structure
        const item = cartItem.product || cartItem;
        const quantity = cartItem.quantity || 1;
        if (!item || !item.price) return;
      %>
        <!-- Cart Item Card -->
        <div class="bg-white border rounded-lg p-4 flex gap-4 hover:shadow-md transition">
          <!-- Product Image -->
          <div class="w-32 h-32 rounded-md overflow-hidden flex-shrink-0 bg-[<%= item.bgcolor %>] flex items-center justify-center">
            <img class="h-28 object-contain" src="data:image/jpeg;base64,<%= item.image.toString('base64') %>" alt="<%= item.name %>">
          </div>

          <!-- Product Details -->
          <div class="flex-1">
            <div class="flex justify-between items-start">
              <div>
                <h3 class="text-lg font-semibold"><%= item.name %></h3>
                <% if (item.category) { %>
                  <p class="text-sm text-gray-500 capitalize"><%= item.category %></p>
                <% } %>
                <% if (item.description) { %>
                  <p class="text-sm text-gray-600 mt-1 line-clamp-2"><%= item.description %></p>
                <% } %>
              </div>
              <a href="/delete/<%= item._id %>" class="text-red-500 hover:text-red-700 text-sm font-medium">
                <i class="ri-delete-bin-line"></i> Remove
              </a>
            </div>

            <!-- Price & Quantity -->
            <div class="mt-3 flex items-center justify-between">
              <div>
                <% if (item.discount > 0) { %>
                  <span class="text-sm text-gray-500 line-through">₹<%= item.price %></span>
                  <span class="text-xl font-bold ml-2">₹<%= (item.price - item.discount).toFixed(2) %></span>
                  <span class="text-sm text-green-600 ml-2">(<%= ((item.discount/item.price)*100).toFixed(0) %>% off)</span>
                <% } else { %>
                  <span class="text-xl font-bold">₹<%= item.price %></span>
                <% } %>
                <p class="text-sm text-gray-600 mt-1">Subtotal: ₹<%= ((item.price - (item.discount || 0)) * quantity).toFixed(2) %></p>
              </div>
              
              <!-- Quantity Controls -->
              <div class="flex items-center gap-2">
                <form action="/cart/update/<%= item._id %>" method="POST" class="flex items-center gap-2">
                  <button type="submit" name="quantity" value="<%= Math.max(1, quantity - 1) %>" class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center hover:bg-gray-300 transition">
                    <i class="ri-subtract-line"></i>
                  </button>
                  <span class="px-3 font-semibold"><%= quantity %></span>
                  <button type="submit" name="quantity" value="<%= quantity + 1 %>" class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center hover:bg-gray-300 transition">
                    <i class="ri-add-line"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Cart Summary Sidebar -->
    <div class="w-[35%]">
      <div class="bg-white border rounded-lg p-6 sticky top-20">
        <h2 class="text-xl font-bold mb-4">Order Summary</h2>
        
        <!-- Price Breakdown -->
        <div class="space-y-3 mb-4">
          <div class="flex justify-between text-gray-700">
            <span>Subtotal (<%= totalItems %> item<%= totalItems !== 1 ? 's' : '' %>)</span>
            <span>₹<%= subtotal.toFixed(2) %></span>
          </div>
          
          <% if (totalDiscount > 0) { %>
          <div class="flex justify-between text-green-600">
            <span>Discount</span>
            <span>-₹<%= totalDiscount.toFixed(2) %></span>
          </div>
          <% } %>
          
          <div class="flex justify-between text-gray-700">
            <span>Platform Fee</span>
            <span>₹20</span>
          </div>
          
          <div class="flex justify-between text-gray-700">
            <span>Shipping</span>
            <span class="text-green-600 font-semibold">FREE</span>
          </div>
        </div>

        <div class="border-t pt-4 mb-6">
          <div class="flex justify-between text-lg font-bold">
            <span>Total Amount</span>
            <span class="text-green-600">₹<%= finalTotal.toFixed(2) %></span>
          </div>
          <% if (totalDiscount > 0) { %>
            <p class="text-sm text-green-600 mt-1">You saved ₹<%= totalDiscount.toFixed(2) %> on this order!</p>
          <% } %>
        </div>

        <!-- Action Buttons -->
        <div class="space-y-3">
          <button
            onclick="orderAllItems()"
            class="w-full bg-black text-white py-3 rounded-md font-semibold hover:bg-gray-800 transition">
            Proceed to Checkout
          </button>
          
          <a href="/shop" class="block w-full text-center border border-gray-300 py-3 rounded-md font-semibold hover:bg-gray-50 transition">
            Continue Shopping
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="mt-6 pt-6 border-t space-y-2 text-sm text-gray-600">
          <div class="flex items-center gap-2">
            <i class="ri-shield-check-line text-green-600"></i>
            <span>Secure Checkout</span>
          </div>
          <div class="flex items-center gap-2">
            <i class="ri-truck-line text-blue-600"></i>
            <span>Free Shipping</span>
          </div>
          <div class="flex items-center gap-2">
            <i class="ri-arrow-go-back-line text-orange-600"></i>
            <span>Easy Returns</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% } %>
</div>

<script>
  function orderAllItems() {
    const items = <%= JSON.stringify(user.cart.map(cartItem => {
      const product = cartItem.product || cartItem;
      const quantity = cartItem.quantity || 1;
      return {
        name: product ? product.name : 'Unknown',
        quantity: quantity,
        price: product ? (product.price - (product.discount || 0)) : 0
      };
    })) %>;
    const total = <%= (cartTotal + 20).toFixed(2) %>;
    
    const whatsappNumber = '+18002428478';
    const whatsappMessage = `*Order Inquiry* 🛒

Hello Team,
I would like to place an order for the following items:

${items.map((item, i) => `${i + 1}. ✅ ${item.name} (Qty: ${item.quantity}) - ₹${(item.price * item.quantity).toFixed(2)}`).join('\n')}

*Total Amount:* ₹${total}

Please share the next steps for completing this order.

Thanks & Regards`;

    const encodedMessage = encodeURIComponent(whatsappMessage);
    const whatsappUrl = `https://api.whatsapp.com/send?phone=${whatsappNumber.replace('+', '')}&text=${encodedMessage}`;
    window.open(whatsappUrl, '_blank');
  }
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<%- include('./partials/footer') %>
